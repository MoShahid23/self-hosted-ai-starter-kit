POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# Generate with: openssl rand -hex 32
# PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
# Do not change N8N_ENCRYPTION_KEY after the first successful n8n start.
N8N_ENCRYPTION_KEY=change-me
N8N_USER_MANAGEMENT_JWT_SECRET=change-me
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Match the Windows host timezone, e.g. Europe/London or America/New_York
GENERIC_TIMEZONE=Europe/London
TZ=Europe/London

OLLAMA_HOST=ollama:11434
